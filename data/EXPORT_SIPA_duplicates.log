be8d1832-463b-4014-834a-dfd9815810c2,b6e7a316-2bb9-4e1e-b8a6-f50322ea302b,identifier,"doi; conflicts=yid,dc.identifier.uri",identifier_conflict,"[""be8d1832-463b-4014-834a-dfd9815810c2"", ""123456789/2"", """", """", """", """", ""carga"", """", """", """", """", ""Michele Dufey||Karina Manríquez-Reyes||Isidora Flores||Juan Arellano||Isabela Aquino||José Ignacio Salazar||Nathacha Escobar||Sigrid Saez||Annette Nuñez||Andrea Rodriguez||Katherina Moya"", """", """", """", """", """", """", """", """", """", """", ""2025-11-03T16:29:18Z||2025-11-03T16:26:19Z"", """", ""2025-11-03T16:29:18Z||2025-11-03T16:26:19Z"", """", """", """", """", ""2025"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""ORCID"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10.1080/14779757.2025.2553554"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""https://doi.org/10.1080/14779757.2025.2553554||https://sipa.uc.cl/handle/123456789/413712"", """", """", """", ""Escuela de Psicología; Karina Pamela Manriquez Reyes; S/I; 1289566||Escuela de Psicología; Juan Esteban Arellano Vega; S/I; 1351487||Escuela de Psicología; Isabela Aquino Oliveira Lima; S/I; 1338662"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""acceso restringido"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Assessing the bodily felt sense: a study of the Chilean Spanish version of the Focusing Manner Scale||Assessing the bodily felt sense: a study of the Chilean Spanish version of th