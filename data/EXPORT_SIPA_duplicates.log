e5b4a99c-1255-48b8-9d97-ba6f86acd633,e2f1af56-4d67-4f10-84ff-1d274461ebf8,identifier,"doi; conflicts=yid,dc.identifier.uri",identifier_conflict,"[""e5b4a99c-1255-48b8-9d97-ba6f86acd633"", ""123456789/2"", """", """", """", """", """", """", """", """", """", ""Herrera C.L.||Barrientos L.||Salazar L.A.||Alvear M.||Montenegro G.||Herrera, Christian L.||Alvear, Marysol||Barrientos, Leticia||Montenegro Rizzardini, Gloria||Salazar, Luis A."", """", """", """", """", """", """", """", """", """", """", ""2021-10-20T21:05:19Z||2022-01-03T18:49:41Z"", """", ""2021-10-20T21:05:19Z||2022-01-03T18:49:41Z"", """", """", """", """", ""2010"", """", """", """", """", """", ""Propolis has been used in traditional medicine for many centuries because of its beneficial health properties, including its antimicrobial capacity. Prosthesis stomatitis affects a significant percentage of users of removable dentures; Candida albicans is the most common fungal species associated with the development of this pathology. Thus, the objectives of this study were: a. To evaluate the antifungal activity of six commercial propolis extracts against Candida spp. that was isolated from the oral cavity of removable dentures users, and b. To determine chemical characteristics of the propolis extracts evaluated. Among the results, we note that these concentrations of polyphenols varied between 9 ± 0.3 and 85 ± 2.1 mg mL-1. Chromatographic analysis was able to detect 35 compounds, among which were caffeic acid, myricetin, quercetin, kaempferol, apigenin, pinocembrin, galangin, and caffeic acid phenyl ester (CAPE). All strains tested were inhibited by the liquid extracts of propolis. The MID ranged between 1:40 and 1:1280, and the MIC for C. albicans ranged from 197 μg mL-1 to 441 μg mL-1. From the results obtained in this investigation, we can conclude that all propolis extracts evaluated are capable of inhibiting the development of Candida spp. However, they show significant differences in the concentration of polyphenols present and in antifungal activity."", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10 páginas"", """", """", """", ""Scopus||Repositorio UC"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10.4067/S0718-16202010000100007"", """", """", """", ""0718-1620"", """", """", """", """", """", ""0304-5609"", """", """", """", """", """", """", """", ""SCOPUS_ID:77953587094"", """", ""http://www.rcia.puc.cl/English/pdf/37-1/07_-_HERRERA.pdf||https://sipa.uc.cl/handle/123456789/339334||https://doi.org/10.4067/S0718-16202010000100007"", """", """", """", ""FACULTAD DE AGRONOMÍA E INGENIERÍA FORESTAL;MONTENEGRO RIZZARDINI GLORIA;S/I;98457"", """", ""No. 1"", """", """", ""es||en"", """", """", """", """", """", """", """", ""84"", """", ""75"", """", """", """", """", """", ""Pontificia Universidad Catolica de Chile, Facultad de Agronomia e Ingenieria Forestal"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Ciencia e Investigacion Agraria||Ciencia e investigación agraria: revista latinoamericana de ciencias de la agricultura"", """", """", """", """", """", ""acceso abierto"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""03 Good health and well-being"", """", ""03 Salud y bienestar"", """", """", """", """", """", """", ""Antifungal activity||Candida albicans||Propolis||Actividad antifúngica||Propóleos"", """", """", """", """", ""The antifungal effect of six commercial extracts of Chilean propolis on candida sppThe antifungal effect of six commercial extracts of Chilean propolis on Candida spp||The antifungal effect of six commercial extracts of Chilean propolis on Candida spp"", """", """", """", """", """", ""The antifungal effect of six commercial extracts of Chilean propolis on candida sppThe antifungal effect of six commercial extracts of Chilean propolis on Candida spp||The antifungal effect of six commercial extracts of Chilean propolis on Candida spp"", ""artículo"", """", """", """", """", """", ""37||Vol. 37"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""98457"", """", """", """", """", """", ""2022-01-05;98457;1"", """", """", """", """", """", """", """", """", """", """", ""e6a5c8ac-3b49-4be8-9ad5-108b90c2255b"", """", """", ""Scopus"", """", ""Sin revisión"", """", """", """", ""Scopus;12-10-2021||Dialnet;29-11-2020||Repositorio UC;08-07-2021"", """", """", ""Sin validar||Validado"", """", ""OSDG;2025-12-22"", """", """", """", ""Validado"", """", ""2022-01-05;98457;1"", """"]","[""e2f1af56-4d67-4f10-84ff-1d274461ebf8"", ""123456789/2"", """", """", """", """", """", """", """", """", """", ""Herrera, Christian L.||Alvear, Marysol||Barrientos, Leticia||Montenegro Rizzardini, Gloria||Salazar, Luis A."", """", """", """", """", """", """", """", """", """", """", ""2022-01-03T18:49:41Z"", """", ""2022-01-03T18:49:41Z"", """", """", """", """", ""2010"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10 páginas"", """", """", """", ""Repositorio UC"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10.4067/S0718-16202010000100007"", """", """", """", ""0718-1620"", """", """", """", """", """", ""0304-5609"", """", """", """", """", """", """", """", """", """", ""https://doi.org/10.4067/S0718-16202010000100007 ||https://sipa.uc.cl/handle/123456789/356370"", """", """", """", ""FACULTAD DE AGRONOMÍA E INGENIERÍA FORESTAL;MONTENEGRO RIZZARDINI GLORIA;S/I;98457"", """", ""No. 1"", """", """", ""en"", """", """", """", """", """", """", """", ""84"", """", ""75"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Ciencia e investigación agraria: revista latinoamericana de ciencias de la agricultura"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Antifungal activity||Candida albicans||Propolis||Actividad antifúngica||Candida albicans||Propóleos"", """", """", """", """", ""The antifungal effect of six commercial extracts of Chilean propolis on Candida spp"", """", """", """", """", """", ""The antifungal effect of six commercial extracts of Chilean propolis on Candida spp"", ""artículo"", """", """", """", """", """", ""Vol. 37"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""98457"", """", """", """", """", """", ""2022-01-05;98457;1"", """", """", """", """", """", """", """", """", """", """", ""e6a5c8ac-3b49-4be8-9ad5-108b90c2255b"", """", """", """", """", """", """", """", """", ""Dialnet;29-11-2020||Repositorio UC;08-07-2021"", """", """", ""Validado"", """", """", """", """", """", ""Validado"", """", ""2022-01-05;98457;1"", """"]"
af27dab0-0628-4cbd-a87d-b08397f83b56,a34527ec-0724-4cee-8c13-aa615d6e31d8,identifier,"doi; conflicts=yid,dc.identifier.uri",identifier_conflict,"[""af27dab0-0628-4cbd-a87d-b08397f83b56"", ""123456789/2"", """", """", """", """", """", """", """", """", """", ""Plaza, Maria Teresa||Martinon Torres, Marcos||Plaza Calonge, María Teresa||Martinón-Torres, M."", """", """", """", """", """", """", """", """", """", """", ""2022-03-30T14:49:37Z||2026-01-20T19:41:52Z"", """", ""2022-03-30T14:49:37Z||2026-01-20T19:41:52Z"", """", """", """", """", ""2021"", """", """", """", """", """", ""The life-histories of gold artefacts can provide rich insight into technology and culture, but so far the potential of this research approach has not been exploited in the south central Andes. Here we present the analysis of 34 gold and silver objects from the Middle Period cemetery of Casa Parroquial (San Pedro de Atacama, northern Chile), using pXRF, SEM-EDS, PIXE and digital microscopy. Chemical analyses detected variable compositions (2.4-73.1 per cent Ag and 0.2-3.4 per cent Cu) suggesting that artisans used both native gold and artificial gold-silver-copper alloys. Based on their manufacturing techniques, quality and designs, we identify two working styles, one technically more 'careful' than the other. Given their elemental and technological variety, together with the lack of local production evidence, we propose that these artefacts were imported as finished objects from Tiwanaku or Cochabamba and northwest Argentina. However, we identify a series of objects that were modified or reshaped as they entered a new cultural context, revealing complex life-histories. Modifications used relatively simple mechanical means: punching, cutting and folding, most likely made in multi-craft contexts by non-metallurgists from San Pedro."", """", """", """", """", """", """", ""Chilean Government||CONICYT (Becas Chile Postdoctorado)||ANID projects||UCL Institute of Archaeology||Historical Metallurgy Society||Access to Research Infrastructures activity in the 7th Framework Programme of the EU (CHARISMA Grant)"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""25"", """", """", """", ""WOS||CCSS"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10.1017/S0959774321000123"", """", """", """", ""1474-0540"", """", """", """", """", """", ""0959-7743"", """", """", """", """", """", """", """", ""SCOPUS_ID:85106188839"", """", ""https://doi.org/10.1017/S0959774321000123||https://sipa.uc.cl/handle/123456789/366095"", """", ""WOS:000721298400007"", """", ""Escuela de Antropología; Plaza Calonge Maria Teresa; S/I; 1156007"", """", ""4"", """", """", ""en"", """", """", """", """", """", """", """", ""637"", """", ""613"", """", """", """", """", """", ""CAMBRIDGE UNIV PRESS"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""CAMBRIDGE ARCHAEOLOGICAL JOURNAL"", """", """", """", """", """", ""acceso abierto"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""SAN PEDRO||CEMETERY||METALS||TRACES||POWER"", """", """", """", """", ""Technology, Use and Reuse of Gold during the Middle Period: The Case of Casa Parroquial, Atacama Desert, Chile||Technology, use and reuse of gold during the Middle Period: The case of Casa Parroquial, San Pedro de Atacama, Chile."", """", """", """", """", """", ""Technology, Use and Reuse of Gold during the Middle Period: The Case of Casa Parroquial, Atacama Desert, Chile||Technology, use and reuse of gold during the Middle Period: The case of Casa Parroquial, San Pedro de Atacama, Chile."", ""artículo"", """", """", """", """", """", ""31"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""1156007"", """", """", """", """", """", ""2025-04-29;1156007;1||2026-01-20;1156007;1"", """", """", """", """", """", """", """", """", """", """", ""