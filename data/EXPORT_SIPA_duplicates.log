4cd03449-5dbf-47b8-8a05-40c19f6c3d38,c8ce7d2e-4c7a-4b37-abc0-b70532baffa6,identifier,"doi; conflicts=yid,dc.identifier.doi,dc.identifier.uri,dc.identifier.wosid",identifier_conflict,"[""4cd03449-5dbf-47b8-8a05-40c19f6c3d38"", ""123456789/2"", """", """", """", """", """", """", """", """", """", ""Fernández, Samuel"", """", """", """", """", """", """", """", """", """", """", ""2020-07-11T02:16:26Z||2020-07-23T15:52:32Z"", """", ""2020-07-11T02:16:26Z||2020-07-23T15:52:32Z"", """", """", """", """", ""2016||2017"", """", """", """", """", """", ""Parisinus lat. 10593 (P), a sixth-century Latin manuscript of Origen's De Principiis, transmits a very important chapter of the work in its entirety, namely the one devoted to the incarnation, i.e., De Principiis II 6. This manuscript has not been used by modern scholars for the constitutio textus of Origen's work. The history and collation of P show that it is an independent witness to Rufinus' Latin translation. The article tries to show the importance of this manuscript and its specific contribution to the reconstruction and re-assessment of the textual tradition of Origen's masterpiece.||The Philocalia transmits in Greek two long chapters of Origen's De principiis. One of the most important manuscripts of the Philocalia, the Venetus Marcianus graecus 47, contains abundant marginal notes, which react to the doctrine of Origen's text. The present article aims to study these marginal notes to reconstruct part of the history of reception of the De principiis."", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""5 páginas"", """", """", """", ""Repositorio UC"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10.15581/006.49.1.9-30"", """", """", """", ""2254-6227"", """", """", """", """", """", ""0036-9764"", """", """", """", """", """", """", """", ""SCOPUS_ID:85018187071"", """", ""https://sipa.uc.cl/handle/123456789/283742||https://doi.org/10.15581/006.49.1.9-30"", """", ""WOS:000456027400018"", """", ""FACULTAD DE TEOLOGÍA;FERNANDEZ EYZAGUIRRE SAMUEL JOSE;S/I;56615"", """", ""No. 1"", """", """", ""en||es"", """", """", """", """", """", """", """", ""327||30"", """", ""323||9"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Adamantius||Scripta Theologica"", """", """", """", """", """", ""acceso abierto"", """", """", """", """", """", """", """", """", """", ""200"", """", """", """", ""Religión"", """", """", """", """", """", """", ""Orígenes - teología||Padres de la Iglesia||Dogmatismo"", """", """", """", """", """", """", """", ""A Neglected Sixth-Century Manuscript of Origen's De Principiis||Criterios para interpretar los textos sinodales según el \""De synodis\"" de Atanasio"", """", """", ""Criteria to interpret synodical texts according to athanasius' de synodis"", """", """", ""A Neglected Sixth-Century Manuscript of Origen's De Principiis||Criterios para interpretar los textos sinodales según el \""De synodis\"" de Atanasio"", ""artículo"", """", """", """", """", """", ""Vol. 22||Vol. 49"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""56615||56615"", """", """", """", """", """", ""2021-09-30;56615;1||2021-07-26;56615;1"", """", """", """", """", """", """", ""71576||70689"", """", """", """", ""0b927388-2531-4707-b810-0b5a2dd399b7||a21c1723-c7fb-4fd1-9979-e07fb9b23138"", """", """", ""Scopus-2017||WOS||Scopus-2013-2014-2015-2017-2019"", """", """", """", """", """", ""Converis;10-07-2020||Repositorio UC;08-07-2021||Converis;23-07-2020"", """", """", ""Validado"", """", ""OSDG;2025-12-22"", """", ""Unpaywall"", """", ""Validado"", """", ""2021-09-30;56615;1||2021-07-26;56615;1"", """"]","[""c8ce7d2e-4c7a-4b37-abc0-b70532baffa6"", ""123456789/2"", """", """", """", """", """", """", """", """", """", ""Fernández, Samuel"", """", """", """", """", """", """", """", """", """", """", ""2020-07-23T15:52:32Z"", """", ""2020-07-23T15:52:32Z"", """", """", """", """", ""2017"", """", """", """", """", """", ""The Philocalia transmits in Greek two long chapters of Origen's De principiis. One of the most important manuscripts of the Philocalia, the Venetus Marcianus graecus 47, contains abundant marginal notes, which react to the doctrine of Origen's text. The present article aims to study these marginal notes to reconstruct part of the history of reception of the De principiis."", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Repositorio UC"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10.17395/86304"", """", """", """", ""2254-6227"", """", """", """", """", """", ""0036-9764"", """", """", """", """", """", """", """", """", """", ""https://doi.org/10.15581/006.49.1.9-30||https://sipa.uc.cl/handle/123456789/260588"", """", ""WOS:000410759200002"", """", ""FACULTAD DE TEOLOGÍA;FERNANDEZ EYZAGUIRRE SAMUEL JOSE;S/I;56615"", """", ""No. 1"", """", """", ""es"", """", """", """", """", """", """", """", ""30"", """", ""9"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Scripta Theologica"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Criterios para interpretar los textos sinodales según el \""De synodis\"" de Atanasio"", """", """", ""Criteria to interpret synodical texts according to athanasius' de synodis"", """", """", ""Criterios para interpretar los textos sinodales según el \""De synodis\"" de Atanasio"", ""artículo"", """", """", """", """", """", ""Vol. 49"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""56615||56615"", """", """", """", """", """