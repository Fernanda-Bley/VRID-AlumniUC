""", """", """", """", """", """", """", """", """", """", ""81"", """", ""53"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Invi"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Accesibilidad y valor de suelo como criterios para una localización racional de vivienda social rural en las comunas de San Bernardo y Calera de Tango"", """", """", """", """", """", ""Accesibilidad y valor de suelo como criterios para una localización racional de vivienda social rural en las comunas de San Bernardo y Calera de Tango"", ""artículo"", """", """", """", """", """", ""29"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""90874"", """", """", """", """", """", ""2014-09-29;90874;0"", """", """", """", """", """", """", ""60644"", """", """", """", """", """", """", ""Scielo-2011-2012-2013-2014||Scopus-2013"", """", """", """", """", """", ""Historial Académico;09-07-2021"", """", """", ""Sin validar"", """", """", """", """", """", ""Validado"", """", ""2014-09-29;90874;1"", """"]"
3af69473-5882-48dd-86e5-69311b9a67fb,9bbc2779-b541-485a-ab3b-bc15d6243ed5,identifier,"doi; conflicts=yid,dc.identifier.uri",identifier_conflict,"[""3af69473-5882-48dd-86e5-69311b9a67fb"", ""123456789/2"", """", """", """", """", """", """", """", """", """", ""Good, Laura W.||Vadas, Peter||Panuska, John C.||Bonilla, Carlos A.||Jokela, William E.||Carlos A. Bonilla||John C. Panuska||Laura W. Good||Peter Vadas||William E. Jokela"", """", """", """", """", """", """", """", """", """", """", ""2021-08-23T16:09:05Z||2021-07-21T21:00:03Z"", """", ""2021-08-23T16:09:05Z||2021-07-21T21:00:03Z"", """", """", """", """", ""2012"", """", """", """", """", """", ""The Wisconsin Phosphorus Index (WPI) is one of several P indices in the United States that use equations to describe actual P loss. processes. Although for nutrient management planning the WPI is reported as a dimensionless whole number, it is calculated as average, annual dissolved P (DP) and particulate P (PP) mass delivered per unit area. The WPI calculations use soil P concentration, applied manure and fertilizer P, and estimates of average annual erosion and average annual runoff. We compared WPI estimated P losses to annual P loads measured in surface runoff from 86 field-years on crop fields and pastures. As the erosion and runoff generated by the weather in the monitoring years varied substantially from the average annual estimates used in the WPI, the WPI and measured loads were not well correlated. However, when measured runoff and erosion were used in the WPI field loss calculations, the WPI accurately estimated annual total P loads with a Nash-Sutcliffe Model Efficiency (NSE) of 0.87. The DP loss estimates were not as close to measured values (NSE = 0.40) as the PP loss estimates (NSE = 0.89). Some errors in estimating DP losses may be unavoidable due to uncertainties in estimating on-farm manure P application rates. The WPI is sensitive to field management that affects its erosion and runoff estimates. Provided that the WPI methods for estimating average annual erosion and runoff are accurately reflecting the effects of management, the WPI is an accurate field-level assessment tool for managing runoff P losses."", """", """", """", """", """", """", ""Otro||USDA"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""11"", """", """", """", ""WOS||Historial Académico"", """", """", """", ""Laura W. Good, Peter Vadas, John C. Panuska, Carlos A. Bonilla, William E. Jokela. Testing the Wisconsin P Index with year-round, field-scale runoff monitoring. Journal Of Environmental Quality. 2012;6(41):1730-1740."", """", """", """", """", """", """", """", """", """", ""10.2134/jeq2012.0001"", """", """", """", ""1537-2537"", """", """", """", """", """", ""0047-2425"", """", """", """", ""MEDLINE:23128730"", """", """", """", ""SCOPUS_ID:84869468751"", """", ""https://doi.org/10.2134/jeq2012.0001||https://sipa.uc.cl/handle/123456789/285655"", """", ""WOS:000311262400004"", """", ""Ingeniería;Carlos A. Bonilla;S/I;80465"", """", ""6||41"", """", """", ""en"", """", """", """", """", """", """", """", ""1740"", """", ""1730"", """", """", """", """", """", ""AMER SOC AGRONOMY"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""JOURNAL OF ENVIRONMENTAL QUALITY"", """", """", """", """", """", ""acceso restringido"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""06 Clean water and sanitation"", """", ""06 Agua limpia y saneamiento"", """", """", """", """", """", """", ""STREAMFLOW||SEDIMENT||LOSSES"", """", """", """", """", ""Testing the Wisconsin Phosphorus Index with Year-Round, Field-Scale Runoff Monitoring||Testing the Wisconsin P Index with year-round, field-scale runoff monitoring"", """", """", """", """", """", ""Testing the Wisconsin Phosphorus Index with Year-Round, Field-Scale Runoff Monitoring||Testing the Wisconsin P Index with year-round, field-scale runoff monitoring"", ""artículo"", """", """", """", """", """", ""41||6"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""80465"", """", """", """", """", """", ""2021-08-19;80465;0||2015-10-26;80465;0"", """", """", """", """", """", """", ""54614||54168||64336"", """", """", """", """", """", """", ""Scopus||WOS||Pubmed||ISI-2002-2006-2007-2008-2012"", """", """", """", """", """", ""WOS;05-06-2021||Historial Académico;09-07-2021"", """", """", ""Sin validar"", """", ""OSDG;2025-12-22"", """", ""Unpaywall"", """", ""Validado"", """", ""2021-08-19;80465;1||2015-10-26;80465;1"", """"]","[""9bbc2779-b541-485a-ab3b-bc15d6243ed5"", ""123456789/2"", """", """", """", """", """", """", """", """", """", ""Carlos A. Bonilla||John C. Panuska||Laura W. Good||Peter Vadas||William E. Jokela"", """", """", """", """", """", """", """", """", """", """", ""2021-07-21T21:00:03Z"", """", ""2021-07-21T21:00:03Z"", """", """", """", """", ""2012"", """", """", """", """", """", """", """", """", """", """", """", """", ""Otro||USDA"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Historial Académico"", """", """", """", ""Laura W. Good, Peter Vadas, John C. Panuska, Carlos A. Bonilla, William E. Jokela. Testing the Wisconsin P Index with year-round, field-scale runoff monitoring. Journal Of Environmental Quality. 2012;6(41):1730-1740."", """", """", """", """", """", """", """", """", """", """", """", """", """", ""1537-2537"", """", """", """", """", """", ""0047-2425"", """", """", """", """", """", """", """", """", """", ""doi:10.2134/jeq2012.0001||https://sipa.uc.cl/handle/123456789/235203"", """", """", """", ""Ingeniería;Carlos A. Bonilla;S/I;80465"", """", ""41"", """", """", """", """", """", """", """", """", """", """", ""1740"", """", ""1730"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Journal of Environmental Quality"", """", """