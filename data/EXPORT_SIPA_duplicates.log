f3f1be4b-ded8-4baa-a8e6-8cd8aedd5aac,da3adffe-0db5-486a-b12a-b76613dd5992,identifier,"doi; conflicts=yid,dc.identifier.uri",identifier_conflict,"[""f3f1be4b-ded8-4baa-a8e6-8cd8aedd5aac"", ""123456789/2"", """", """", """", """", ""yvc"", """", """", """", """", ""Loewe Lobo, Marcelo Patricio||Monje Apablaza, Leandro Nicolas||Zamora Jofré, Renato Andres||Loewe M||Monje L||Zamora R"", """", """", """", """", """", """", """", """", """", """", ""2020-09-01T21:25:44Z||2021-07-21T21:26:18Z"", """", ""2020-09-01T21:25:44Z||2021-07-21T21:26:18Z"", """", """", """", """", ""2018"", """", """", """", """", """", ""In this article, we consider the magnetic corrections to pi-pi scattering lengths in the frame of the linear sigma model. For this, we consider all the one-loop corrections in the s, t, and u channels, associated to the insertion of a Schwinger propagator for charged pions, working in the region of small values of the magnetic field. Our calculation relies on an appropriate expansion for the propagator. It turns out that the leading scattering length, l = 0 in the S channel, increases for an increasing value of the magnetic field, in the isospin I = 2 case, whereas the opposite effect is found for the I = 0 case. The isospin symmetry is valid because the insertion of the magnetic field occurs through the absolute value of the electric charges. The channel I = 1 does not receive any corrections. These results, for the channels I = 0 and I = 2, are opposite with respect to the thermal corrections found previously in the literature."", """", """", """", """", """", """", ""FONDECYT"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""6 páginas"", """", """", """", ""Repositorio UC||Historial Académico"", """", """", """", ""Loewe M, Monje L , Zamora R. Magnetic corrections to p-p scattering lengths in the linear sigma model. Physical Review D. 2018;97(5):1-6."", """", """", """", """", """", """", """", """", """", ""10.1103/PhysRevD.97.056023"", """", """", """", ""1089-4918"", """", """", """", """", """", ""2470-0010"", """", """", """", """", """", """", """", ""SCOPUS_ID:85044853479"", """", ""https://doi.org/10.1103/PhysRevD.97.056023||https://sipa.uc.cl/handle/123456789/219037"", """", ""WOS:000428390100005"", """", ""Instituto de Física; Monje Apablaza, Leandro Nicolas; S/I; 249895||Instituto de Física; Loewe Lobo, Marcelo Patricio; 0000-0002-8998-6923; 55612||Instituto de Física; Zamora Jofré, Renato Andrés; 0000-0002-2223-3361; 162063||Física;Loewe M;S/I;55612||Física;Monje L ;S/I;249895"", """", ""5"", """", """", ""en"", """", """", """", """", """", """", """", ""6"", """", ""1"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Physical Review D"", """", """", """", """", """", ""acceso abierto"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Magnetic corrections to π−π scattering lengths in the linear sigma model||Magnetic corrections to p-p scattering lengths in the linear sigma model"", """", """", """", """", """", ""Magnetic corrections to π−π scattering lengths in the linear sigma model||Magnetic corrections to p-p scattering lengths in the linear sigma model"", ""artículo"", """", """", """", """", """", ""97"", """", """", """", """", """", """", """", """", ""Si||No"", """", """", ""249895||55612||162063"", """", """", """", """", """", ""2026-03-12;249895;1||2026-03-12;55612;1||2026-03-12;162063;1||2018-07-26;55612;0||2018-07-26;249895;0"", """", """", """", """", """", """", ""75929"", """", """", """", ""d6f816ff-dd81-48ba-8909-e49c5b35d670"", """", """", ""Scopus||WOS||ISI-1993-1994-1995-1997-2000-2001-2002-2003-2004-2005-2006-2007-2008-2009-2010-2011-2012-2013-2014-2015-2016-2017-2018||Scopus-2010-2011-2012-2013-2014-2015-2016-2017-2018"", """", """", """", """", """", ""Converis;01-