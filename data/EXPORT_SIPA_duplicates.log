ology Neurosurgery and Psychiatry"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Letter: Mtdna Mutations in Chilean Patients With Optic Neuropathy"", """", """", """", """", """", ""Letter: Mtdna Mutations in Chilean Patients With Optic Neuropathy"", ""artículo"", """", """", """", """", """", ""71"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""73879"", """", """", """", """", """", ""2009-05-28;73879;0"", """", """", """", """", """", """", ""29110"", """", """", """", """", """", """", ""ISI-1992-2001"", """", """", """", """", """", ""Historial Académico;09-07-2021"", """", """", ""Sin validar"", """", """", """", """", """", ""Validado"", """", ""2009-05-28;73879;1"", """"]"
5a1c8e65-cb12-4648-b6f3-dd6fad6c8a7b,77bf4458-eee9-460b-961d-ad5f0f29b83b,identifier,"doi; conflicts=yid,dc.identifier.uri",identifier_conflict,"[""5a1c8e65-cb12-4648-b6f3-dd6fad6c8a7b"", ""123456789/2"", """", """", """", """", """", """", """", """", """", ""Zaror, L||Ernst, S||Navarrete, M||Ballesteros, A||Boroscheck, D||Ferres, M||Thibaut, J||Bellesteros A"", """", """", """", """", """", """", """", """", """", """", ""2021-07-23T02:43:33Z||2021-07-21T18:53:47Z"", """", ""2021-07-23T02:43:33Z||2021-07-21T18:53:47Z"", """", """", """", """", ""2002"", """", """", """", """", """", ""A convenience sample from 76 cats from the city of Valdivia, Chile was selected between April and September 1999 to detect Bartonella henselae antibodies. The cats were from the||Veterinary Teaching Hospital of the Universidad Austral de Chile and several private clinics. The presence of antibodies to Bartonella henselae was tested for by indirect immunofluorescence. Descriptive data on sex, age, indoors and outdoors activity and flea infestation were recorded.||Fifty four (71.0%) cats were for Bartonella henselae antibody positive. Seroprevalence was 68.4% in males and 73.7% in females. Cats 3-6 years old had a higher antibody prevalence than younger and older cats. Twenty nine (69.0%) cats that lived completely indoors and 25 (73.5%) cats that lived mostly outdoors were seropositives. Fifty (75.0%) cats reported to be infested with fleas had B. henselae antibodies.||Human sera were obtained from 22 asymptomatic adults owning Bartonella henselae seropositives cats. Four persons (18%) showed serological evidence of infection."", """", """", """", """", """", """", ""No tiene"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""8"", """", """", """", ""WOS||Historial Académico"", """", """", """", ""Zaror L, Ernst S, Navarrete M, Bellesteros A, Boroscheck D, Ferres M, Thibaut J. Deteccion Serologica de Bartonella Henselae en Gatos en la Ciudad de Valdivia, Chile. Archivos De Medicina Veterinaria. 2002;34(1):103-110."", """", """", """", """", """", """", """", """", """", ""10.4067/S0301-732X2002000100011"", """", """", """", ""0717-6201"", """", """", """", """", """", ""0301-732X"", """", """", """", """", """", """", """", """", """", ""https://doi.org/10.4067/S0301-732X2002000100011||https://sipa.uc.cl/handle/123456789/256070"", """", ""WOS:000176318200011"", """", ""Medicina;Ferres M;S/I;66180"", """", ""1"", """", """", ""es"", """", """", """", """", """", """", """", ""110"", """", ""103"", """", """", """", """", """", ""UNIV AUSTRAL CHILE, FAC CIENCIAS VETERINARIAS"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""ARCHIVOS DE MEDICINA VETERINARIA"", """", """", """", """", """", ""acceso abierto"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""03 Good health and well-being"", """", ""03 Salud y bienestar"", """", """", """", """", """", """", ""CSD||Bartonella henselae||cats||HUMAN-IMMUNODEFICIENCY-VIRUS||SCRATCH DISEASE PATIENTS||ROCHALIMAEA-HENSELAE||DOMESTIC CAT||SP-NOV||POSITIVE PATIENT||RISK-FACTORS||ENDOCARDITIS||PREVALENCE||BACTEREMIA"", """", """", """", """", ""Serologic detection of Bartonella henselae in cats in the city of Valdivia, Chile.||Deteccion Serologica de Bartonella Henselae en Gatos en la Ciudad de Valdivia, Chile"", """", """", """", """", """", ""Serologic detection of Bartonella henselae in cats in the city of Valdivia, Chile.||Deteccion Serologica de Bartonella Henselae en Gatos en la Ciudad de Valdivia, Chile"", ""artículo"", """", """", """", """", """", ""34"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""66180"", """", """", """", """", """", ""2009-05-28;66180;0"", """", """", """", """", """", """", ""30191"", """", """", """", """", """", """", ""WOS||ISI-1996-2000-2001-2002-2003-2004-2005-2006-2007-2008-2009-2010-2011-2015-2016||Scielo-2008-2009-2010||Scopus-2015-2016"", """",