 scaffold for targeting VEGFR-2 in antiangiogenic research."", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""11 páginas"", """", """", """", ""SIPA"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10.1039/D5RA09658H"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""https://sipa.uc.cl/handle/123456789/418345||https://doi.org/10.1039/D5RA09658H"", """", """", """", ""Escuela de Química; Lopez Villa, Jhon Jairo; S/I; 198504"", """", ""8"", """", """", ""en"", """", """", """", """", """", """", """", ""7658"", """", ""7648"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""RSC Advances"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""510"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Multimodal characterization of a pyrazolo[3,4-b] pyridine aldehyde: quantum chemical insights, NLO activity and VEGFR-2 docking/molecular dynamics"", """", """", """", """", """", ""Multimodal characterization of a pyrazolo[3,4-b] pyridine aldehyde: quantum chemical insights, NLO activity and VEGFR-2 docking/molecular dynamics"", ""artículo"", """", """", """", """", """", ""16"", """", """", """", """", """", """", """", """", """", """", """", ""198504"", """", ""3/9/2026"", """", """", """", ""2026-03-09;198504;1"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Validado"", """", """", """", """", """", ""Validado"", """", ""2026-03-09;198504;1"", """"]"
