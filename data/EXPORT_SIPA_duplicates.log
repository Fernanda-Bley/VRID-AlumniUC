2d75554c-d5f4-4c13-996c-0bafb0f9ca84,d63bd023-2e82-42a7-a357-a300b6084cda,identifier,"doi; conflicts=yid,dc.identifier.uri",identifier_conflict,"[""2d75554c-d5f4-4c13-996c-0bafb0f9ca84"", ""123456789/2"", """", """", """", """", ""jca||carga"", """", """", """", """", ""Bachmann Caceres, Ingrid Andrea||Valenzuela Leighton, Sebastián Andres||Ingrid Bachmann||Sebastián Valenzuela"", """", """", """", """", """", """", """", """", """", """", ""2025-12-19T22:27:14Z||2025-12-22T11:50:34Z"", """", ""2025-12-19T22:27:14Z||2025-12-22T11:50:34Z"", """", """", """", """", ""2025"", """", """", """", """", """", ""Fact-checking has been shown to be an effective method for improving the accuracy of people’s beliefs, even though it may not completely eliminate the impact of being exposed to misinformation. However, little is known about the antecedents and consequences of exposure to fact-checks beyond belief accuracy. In this chapter, we review the existing literature and evidence on fact-checking and argue that in times of endemic misinformation, it is important to examine more fully the specific effects of exposure to corrections and to consider other outcomes beyond belief accuracy."", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""13 páginas"", """", """", """", ""SIPA||ORCID"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10.4324/9781032725154-13"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""https://doi.org/10.4324/9781032725154-13||https://sipa.uc.cl/handle/123456789/415020"", """", """", """", ""Facultad de Comunicaciones; Bachmann Caceres, Ingrid Andrea; 0000-0002-2805-5148; 4313||Facultad de Comunicaciones; Valenzuela Leighton, Sebastián Andres; 0000-0001-5991-7364; 6859"", """", """", """", """", ""en"", """", """", """", """", """", ""contenido parcial"", """", """", """", """", """", "