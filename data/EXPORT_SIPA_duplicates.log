"""", """", """", """", """", ""Propio"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Historial Académico"", """", """", """", ""Graca Pinheiro, Fernando Saldías. VI:Entrenamiento muscular inspiratorio en el paciente con enfermedad pulmonar obstructiva crónica. Revista Chilena De Enfermedades Repiratorias. 2011;27(2):116-123."", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""0717-5698"", """", """", """", """", """", """", """", """", """", ""http://dx.doi.org/10.4067/S0717-73482011000200006||https://sipa.uc.cl/handle/123456789/230574"", """", """", """", ""Medicina;Fernando Saldías;S/I;67197||Medicina;Graca Pinheiro;S/I;182427"", """", ""2"", """", """", """", """", """", """", """", """", """", """", ""123"", """", ""116"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Revista Chilena de Enfermedades Repiratorias"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""VI:Entrenamiento muscular inspiratorio en el paciente con enfermedad pulmonar obstructiva crónica"", """", """", """", """", """", ""VI:Entrenamiento muscular inspiratorio en el paciente con enfermedad pulmonar obstructiva crónica"", ""artículo"", """", """", """", """", """", ""27"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""67197||182427"", """", """", """", """", """", ""2013-10-04;67197;0||2013-10-04;182427;0"", """", """", """", """", """", """", ""56857"", """", """", """", """", """", """", ""Scielo-1991-1992-1993-1994-1995-1996-1997-1998-1999-2000-2001-2002-2003-2004-2005-2006-2007-2008-2009||Scopus-2011-2012"", """", """", """", """", """", ""Historial Académico;09-07-2021"", """", """", ""Sin validar"", """", """", ""