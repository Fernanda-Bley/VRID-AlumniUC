47aea840-0baa-493b-b434-8811f60cb316,9c9a4ec0-aafa-490d-a4ff-bbe9b066cc6a,identifier,"doi; conflicts=yid,dc.identifier.doi,dc.identifier.eissn,dc.identifier.issn,dc.identifier.scopusid,dc.identifier.uri",identifier_conflict,"[""47aea840-0baa-493b-b434-8811f60cb316"", ""123456789/2"", """", """", """", """", """", """", """", """", """", ""Estupina, C.||Belmar Canales, Jorge."", """", """", """", """", """", """", """", """", """", """", ""2017-04-11T14:43:28Z"", """", ""2017-04-11T14:43:28Z"", """", """", """", """", ""1996"", """", """", """", """", """", ""The median eminence (ME) push-pull perfusion technique was used in this work and the results clearly showed that ip. administration of MK-801 (4 mg/kg), a specific N-methyl-D-aspartate (NMDA) receptor antagonist, totally abolished dexamethasone (Dex) (300 mu g/100g i.p. injected) and immobilization stress-induced hypothalamic somatostatin release in adult male rats. We also observed that glutamate from median eminence-hypothalamic medio basal (ME-MBH) complex, measured by high performance Liquid chromatography (HPLC), exhibited a conspicuous secretory pattern, with the total amount released not modified by Dex administration. This indicates that Dex and stress-induced somatostatin (SS) secretion is not mediated by endogenous glutamate variations but likely by activation of NMDA receptors."", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Repositorio UC"", """", """", """", """", """", """", """", """", """", """", """", """", """", ""10.1159/000126955"", """", """", """", ""1872-7972"", """", """", """", """", """", ""0304-3940"", """", """", """", """", """", """", """", ""SCOPUS_ID:0030030340"", """", ""https://sipa.uc.cl/handle/123456789/276487||https://doi.org/10.1016/s0304-3940(96)13211-0"", """", ""WOS:A1996VX50400016"", """", """", """", """", """", """", ""en"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Neuroscience Letters. Vol. 219, no. 3 (1996), p. [203]-206||Neuroendocrinology. Vol. 63, no. 2 (1996), p. [181]-187"", """", """", """", """", """", """", """", """", """", """", ""Neuroscience Letters||Neuroendocrinology"", """", """", """", """", """", ""acceso restringido"", """", """", """", """", """", """", """", """", """", ""610"", """", """", """", ""Medicina y salud"", ""03 Good health and well-being"", """", ""03 Salud y bienestar"", """", """", """", ""Cerebro||Glutamato||Hipotálamo||Somatostatina||Dexametasona"", """", """", """", """", """", """", """", ""N-Methyl-D-Aspartate Receptor Involvement in Dexamethasone and Stress-Induced Hypothalamic Somatostatin Release in Rats||Variations in Hypothalamic Somatostatin Release and Content During the Estrous Cycle in the Rat. Effect of Ovariectomy and Estrogen Supplementation"", """", """", """", """", """", ""N-Methyl-D-Aspartate Receptor Involvement in Dexamethasone and Stress-Induced Hypothalamic Somatostatin Release in Rats||Variations in Hypothalamic Somatostatin Release and Content During the Estrous Cycle in the Rat. Effect of Ovariectomy and Estrogen Supplementation"", ""artículo"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Si"", """", """", ""98131"", """", """", """", """", """", ""2021-09-30;98131;1||2021-07-26;98131;1"", """", """", """", """", """", """", ""26213||25745"", """", """", """", ""2831b199-bb9c-467d-8524-6877867e4be4||e61a09d4-b987-43a7-8366-a4176f515a96"", """", """", ""ISI-1990-1991-1992-1993-1994-1995-1996-1997-1998-1999-2000-2006-2007-2008-2009-2010-2011-2014-2015-2016-2017||Scopus-2010-2011-2014-2015-2016-2017||WOS||Scopus||ISI"", """", """", """", """", """", ""Repositorio UC;11-04-2017"", """", """", ""Validado"", """", ""OSDG;2025-12-22"", """", ""Unpaywall"", """", ""Validado"", """", ""2021-09-30;98131;1||2021-07-26;98131;1"", """"]","[""9c9a4ec0-aafa-490d-a4ff-bbe9b0