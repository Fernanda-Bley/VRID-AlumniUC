""", """", """", """", """", """", ""Fernando Soler"", """", """", """", """", """", """", """", """", """", """", ""2021-07-21T21:34:58Z"", """", ""2021-07-21T21:34:58Z"", """", """", """", """", ""2018"", """", """", """", """", """", """", """", """", """", """", """", """", ""Unidad Académica"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Historial Académico"", """", """", """", ""Fernando Soler. Mística del Logos y contemplación del Padre en Orígenes. Aproximaciones desde el comentario a Juan. Teologia Y Vida. 2018;4(59):503-518."", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""0049-3449"", """", """", """", """", """", """", """", """", """", ""http://dx.doi.org/10.4067/S0049-34492018000400503||https://sipa.uc.cl/handle/123456789/238780"", """", """", """", ""Teología;Fernando Soler;S/I;134542"", """", ""59"", """", """", """", """", """", """", """", """", """", """", ""518"", """", ""503"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Teología y Vida"", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", """", ""Mística del Logos y contemplación del Padre en Orígenes. Aproximaciones desde el comentario a Juan"", """", """", """", """", """", ""Mística del Logos y contemplación del Padre en Orígenes. Aproximaciones desde el comentario a Juan"", ""artículo"", """", """", """", """", """", ""4"", """", """", """", """", """", """", """", """", ""Si"", """", """", ""134542"", """", """", """", """", """", ""2019-02-27;134542;0"", """", """", """", """", """", """", ""77369"", """", """", """", """", """", """", ""ISI-2007-2008-2009-2010-2011-2012-2013-2014-2015-2016-2017-2019-2020||Scielo-1990-1991-1992-1993-1994-1995-199